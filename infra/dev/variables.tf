variable "epoch_id" {
  type        = number
  description = "Current cryptographic time epoch"
}

variable "active_color" {
  type        = string
  description = "Active deployment plane (BLUE or GREEN)"
}

variable "active_honeytoken_trap" {
  type        = string
  description = "Epoch-rotated cryptographic honeytoken string"
}

variable "europa_active_topology" {
  type        = map(string)
  description = "Dynamic mapping of architectural roles to /24 CIDR blocks"
}

variable "ephemeral_pipeline_policy" {
  type        = any
  description = "JSON policy document generated by Identity Guardian for JIT access"
}

variable "quarantine_honeybucket" {
  type        = string
  description = "Name of the dynamic deception honeybucket"
}
