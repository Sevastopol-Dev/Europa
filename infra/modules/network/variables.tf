variable "epoch_id" {
  type        = number
  description = "Monotonically increasing sequence identifier representing the active Moving Target Defense (MTD) temporal epoch window."

  validation {
    condition     = var.epoch_id >= 0
    error_message = "The epoch_id variable must be a non-negative integer sequence."
  }
}

variable "active_color" {
  type        = string
  description = "The target deployment plane color designated as active during the current epoch transition (e.g., 'blue' or 'green')."

  validation {
    condition     = contains(["blue", "green"], lower(var.active_color))
    error_message = "The active_color variable must be set strictly to either 'blue' or 'green'."
  }
}

variable "active_honeytoken_trap" {
  type        = string
  description = "Cryptographic seed or identity string assigned to dynamic deception honeytokens deployed within the trap subnet tier."
}

variable "europa_active_topology" {
  type        = map(string)
  description = "Dynamic CIDR block mapping generated by the control plane (europa_brain.py) for active subnets during the current epoch."

  validation {
    condition     = contains(keys(var.europa_active_topology), "perimeter_ingress_alpha") && contains(keys(var.europa_active_topology), "deception_honeytoken_tier")
    error_message = "The europa_active_topology map must contain valid keys for both 'perimeter_ingress_alpha' and 'deception_honeytoken_tier'."
  }
}

variable "oob_management_cidr" {
  type        = string
  default     = "10.199.255.0/28"
  description = "Immutable Out-of-Band (OOB) administrative management subnet CIDR block used to prevent administrative lockouts across epoch transitions."

  validation {
    condition     = var.oob_management_cidr == "10.199.255.0/28"
    error_message = "The oob_management_cidr is locked to '10.199.255.0/28' and cannot be modified."
  }
}